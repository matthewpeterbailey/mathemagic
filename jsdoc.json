{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["README.md", "lib"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\\/|\\\\)_"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "template": "node_modules/jsdoc/templates/default"
  },
  "templates": {
    "default": {
      "outputSourceFiles": true
    }
  }
}
